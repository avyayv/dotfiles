#!/usr/bin/env node
import fs from "node:fs";
import http from "node:http";
import os from "node:os";
import path from "node:path";

const HOME = os.homedir();
const AGENT_DIR = process.env.PI_PERSONAL_AGENT_DIR || path.join(HOME, ".pi", "agent-personal");
const ROOT = process.env.PI_IMESSAGE_AGENT_ROOT || path.join(AGENT_DIR, "imessage-agent");

const DEFAULT_HOST = process.env.PI_IMESSAGE_WEBHOOK_HOST || "127.0.0.1";
const DEFAULT_PORT = Number(process.env.PI_IMESSAGE_WEBHOOK_PORT || 47761);
const DEFAULT_TOKEN_FILE = process.env.PI_IMESSAGE_WEBHOOK_TOKEN_FILE || path.join(ROOT, "webhook-token");

function usage(exitCode = 0) {
  const stream = exitCode === 0 ? process.stdout : process.stderr;
  stream.write(`Usage: pi-imessage-agent-message --from <name> [--text <text>] [--idempotency-key <key>] [--reply-mode imessage|none]\n\nIf --text is omitted, text is read from stdin.\n\nOptions:\n  --from, --source <name>        Local subagent/source name\n  --text, -t <text>             Message text (otherwise stdin)\n  --idempotency-key <key>       Recent duplicate suppression key\n  --reply-mode <mode>           imessage (default) or none\n  --metadata-json <json>        Optional metadata object JSON\n  --host <host>                 Webhook host (default ${DEFAULT_HOST})\n  --port <port>                 Webhook port (default ${DEFAULT_PORT})\n  --token-file <path>           Token file (default ${DEFAULT_TOKEN_FILE})\n  --check                       Print resolved config and exit\n  --help                        Show this help\n`);
  process.exit(exitCode);
}

function fail(message) {
  process.stderr.write(`pi-imessage-agent-message: ${message}\n`);
  process.exit(1);
}

function requireValue(args, index, option) {
  const value = args[index + 1];
  if (value === undefined || value.startsWith("--")) fail(`${option} requires a value`);
  return value;
}

const args = process.argv.slice(2);
let source = null;
let text = null;
let idempotencyKey = null;
let replyMode = "imessage";
let metadata = undefined;
let host = DEFAULT_HOST;
let port = DEFAULT_PORT;
let tokenFile = DEFAULT_TOKEN_FILE;
let checkOnly = false;

for (let i = 0; i < args.length; i += 1) {
  const arg = args[i];
  if (arg === "--help" || arg === "-h") usage(0);
  if (arg === "--check") {
    checkOnly = true;
    continue;
  }
  if (arg === "--from" || arg === "--source" || arg === "-f") {
    source = requireValue(args, i, arg);
    i += 1;
    continue;
  }
  if (arg === "--text" || arg === "-t") {
    text = requireValue(args, i, arg);
    i += 1;
    continue;
  }
  if (arg === "--idempotency-key") {
    idempotencyKey = requireValue(args, i, arg);
    i += 1;
    continue;
  }
  if (arg === "--reply-mode") {
    replyMode = requireValue(args, i, arg);
    i += 1;
    continue;
  }
  if (arg === "--metadata-json") {
    const raw = requireValue(args, i, arg);
    try {
      metadata = JSON.parse(raw);
    } catch {
      fail("--metadata-json must be valid JSON");
    }
    if (!metadata || typeof metadata !== "object" || Array.isArray(metadata)) fail("--metadata-json must be a JSON object");
    i += 1;
    continue;
  }
  if (arg === "--host") {
    host = requireValue(args, i, arg);
    i += 1;
    continue;
  }
  if (arg === "--port") {
    port = Number(requireValue(args, i, arg));
    i += 1;
    continue;
  }
  if (arg === "--token-file") {
    tokenFile = requireValue(args, i, arg);
    i += 1;
    continue;
  }
  fail(`unknown argument: ${arg}`);
}

if (!Number.isInteger(port) || port < 1 || port > 65535) fail(`invalid port: ${port}`);
if (replyMode !== "imessage" && replyMode !== "none") fail("--reply-mode must be imessage or none");

const endpoint = `http://${host.includes(":") && !host.startsWith("[") ? `[${host}]` : host}:${port}/message`;
if (checkOnly) {
  let tokenFileExists = false;
  let tokenFileMode = null;
  try {
    const stat = fs.statSync(tokenFile);
    tokenFileExists = stat.isFile();
    tokenFileMode = `0${(stat.mode & 0o777).toString(8)}`;
  } catch {}
  process.stdout.write(`${JSON.stringify({ host, port, tokenFile, tokenFileExists, tokenFileMode, endpoint }, null, 2)}\n`);
  process.exit(0);
}

if (!source) fail("--from <name> is required");
if (text === null) {
  if (process.stdin.isTTY) fail("provide --text or pipe message text on stdin");
  text = fs.readFileSync(0, "utf8");
}
if (!text.trim()) fail("message text is empty");

let token;
try {
  token = fs.readFileSync(tokenFile, "utf8").trim();
} catch (error) {
  fail(`failed to read token file ${tokenFile}: ${error.message}`);
}
if (!token) fail(`token file ${tokenFile} is empty`);

const payload = { from: source, text, replyMode };
if (idempotencyKey) payload.idempotencyKey = idempotencyKey;
if (metadata !== undefined) payload.metadata = metadata;

const body = JSON.stringify(payload);
const requestHost = host.startsWith("[") && host.endsWith("]") ? host.slice(1, -1) : host;

const req = http.request({
  hostname: requestHost,
  port,
  path: "/message",
  method: "POST",
  headers: {
    authorization: `Bearer ${token}`,
    "content-type": "application/json",
    "content-length": Buffer.byteLength(body),
  },
}, (res) => {
  const chunks = [];
  res.on("data", (chunk) => chunks.push(chunk));
  res.on("end", () => {
    const responseBody = Buffer.concat(chunks).toString("utf8");
    if (res.statusCode < 200 || res.statusCode >= 300) {
      process.stderr.write(`pi-imessage-agent-message: HTTP ${res.statusCode}: ${responseBody}\n`);
      process.exit(1);
    }
    process.stdout.write(responseBody ? `${responseBody}\n` : `{"ok":true}\n`);
  });
});

req.on("error", (error) => fail(`request failed for ${endpoint}: ${error.message}`));
req.write(body);
req.end();
